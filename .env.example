NODE_ENV=development
PORT=4000
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
APP_TIMEZONE=Asia/Kolkata

SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=prescriptions

CLERK_SECRET_KEY=your_clerk_secret_key_here
CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret_here
FOUNDER_CLERK_USER_IDS=user_founder_1,user_founder_2
SENTRY_DSN=https://your-sentry-dsn-here
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

POSTHOG_ENABLED=false
POSTHOG_API_KEY=your_posthog_api_key_here
POSTHOG_HOST=https://us.i.posthog.com

FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_CLIENT_EMAIL=your_firebase_client_email_here
FIREBASE_PRIVATE_KEY=your_firebase_private_key_here

OCR_PROVIDER=vision_gemini
OCR_TIMEOUT_MS=30000

GEMINI_API_KEY=AIzaSyBe6Rj8QjIuCSPiu8lvWTK1XiUEWUp4uoY
GEMINI_MODEL=gemini-2.0-flash

# Google Vision (enable Cloud Vision API on the GCP project). Use ONE of:
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-vision-service-account.json

RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

CLERK_JWT_PUBLIC_KEY=

ENABLE_SCHEDULER=true
CRON_REMINDER_SCAN=*/5 * * * *
CRON_REFILL_SCAN=0 */6 * * *
