{
  "name": "renomedy-backend",
  "version": "1.0.0",
  "description": "Renomedy backend API - Prescription Clarity + Family Medication Governance",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint:check": "npm run typecheck",
    "test": "npm run build && node --test ./tests/*.test.js"
  },
  "keywords": [
    "renomedy",
    "healthcare",
    "clerk",
    "supabase",
    "express",
    "typescript"
  ],
  "author": "Renomedy",
  "license": "UNLICENSED",
  "dependencies": {
    "@clerk/backend": "^1.24.3",
    "@google/genai": "^2.0.1",
    "google-auth-library": "^9.15.1",
    "@sentry/node": "^10.51.0",
    "@supabase/supabase-js": "^2.49.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^10.1.0",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "posthog-node": "^5.21.2",
    "svix": "^1.61.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
